{
  "name": "cinestream",
  "version": "1.0.0",
  "private": true,
  "description": "CineStream - Modern Dark-Themed Movie Streaming Platform",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "pages:dev": "npx wrangler pages dev dist",
    "pages:deploy": "vite build && npx wrangler pages deploy dist --project-name=cinestream",
    "d1:create": "npx wrangler d1 create cinestream_db",
    "d1:init:local": "npx wrangler d1 execute cinestream_db --local --file=./prisma/schema.sql",
    "d1:init:remote": "npx wrangler d1 execute cinestream_db --remote --file=./prisma/schema.sql"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "vite-plugin-html-inject": "^1.1.2",
    "wrangler": "^4.136.0"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "next": "^14.2.25",
    "page-mascot": "^0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
